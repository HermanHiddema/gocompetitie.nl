<% content_for :title, @venue.name %>
<%= page_header @venue.name, class: "mb-2" do %>
  <% if admin? %>
    <%= button_link_to "Locatie bewerken", edit_venue_path(@venue, **season_url_options), short: "Bewerken" %>
  <% end %>
<% end %>
<p class="mb-6 text-slate-600"><%= @venue.address %>, <%= @venue.city %></p>

<section class="mb-8 rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
  <p class="text-sm">
    <span class="font-semibold">Speelavond:</span>
    <%= @venue.playing_day_name %> om <%= @venue.playing_time %>
  </p>
  <% if @venue.club %>
    <p class="mt-1 text-sm">
      <span class="font-semibold">Club:</span>
      <%= link_to @venue.club.name, club_path(@venue.club, **season_url_options), class: "hover:underline" %>
    </p>
  <% end %>
  <%= markdown @venue.info %>
</section>

<section class="mb-8 rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
  <h2 class="mb-3 text-lg font-semibold">Wedstrijden</h2>
  <%= render "matches/grid", matches: @matches %>
</section>
