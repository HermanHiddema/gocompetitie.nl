<div class="grid grid-cols-2 gap-x-4 gap-y-1 border-b border-slate-100 py-2 text-sm last:border-0 md:grid-cols-4">
  <div class="font-medium"><%= link_to venue.city, venue, class: "hover:underline" %></div>
  <div class="text-slate-600"><%= venue.playing_day_name %></div>
  <div class="text-slate-600"><%= venue.playing_time %></div>
  <div class="text-slate-600"><%= venue.name %>, <%= venue.address %></div>
</div>
