<% content_for :title, "Stand #{@season&.name}" %>

<% if @season&.information.present? %>
  <section class="mb-8 rounded-lg bg-white p-5 shadow-sm ring-1 ring-slate-200">
    <%= markdown @season.information %>
  </section>
<% end %>

<% badge = season_phase_badge(@season, class: "rounded-full bg-slate-100 px-2 py-1 text-xs") if @season && !@season.active? %>

<%= page_header "Stand #{@season&.name}", badge: badge do %>
  <% if admin? && @season %>
    <% if @season.editable? %>
      <%= button_link_to "Seizoen bewerken", edit_season_path(@season), short: "Bewerken" %>
    <% end %>
    <% if @season.draft? %>
      <%= button_link_to "Poule toevoegen", new_league_path(season_id: @season.id), short: "+ Poule" %>
      <%= button_to button_label("Seizoen starten", "Starten"), start_season_path(@season), class: button_classes %>
    <% end %>
  <% end %>
<% end %>

<% if @leagues.blank? %>
  <p class="text-slate-600">Er zijn nog geen poules voor dit seizoen.</p>
<% else %>
  <div class="grid gap-6 lg:grid-cols-2">
    <% @leagues.each do |league| %>
      <section class="min-w-0 rounded-lg bg-white px-2 py-4 shadow-sm ring-1 ring-slate-200 sm:p-4">
        <h2 class="mb-3 text-lg font-semibold">
          <%= link_to league.name, league, class: "hover:underline" %>
        </h2>
        <%= render "leagues/standings", league: league %>
      </section>
    <% end %>
  </div>
<% end %>
