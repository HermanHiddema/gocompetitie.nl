<% content_for :title, "Stand #{@season&.name}" %>

<% if @season&.information.present? %>
  <section class="mb-8 rounded-lg bg-white p-5 shadow-sm ring-1 ring-slate-200">
    <%= markdown @season.information %>
  </section>
<% end %>

<div class="mb-6 flex flex-wrap items-center gap-3">
  <h1 class="text-2xl font-bold">Stand <%= @season&.name %></h1>
  <% if @season && !@season.active? %>
    <span class="rounded-full bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-600"><%= season_phase_name(@season) %></span>
  <% end %>
</div>

<% if @leagues.blank? %>
  <p class="text-slate-600">Er zijn nog geen poules voor dit seizoen.</p>
<% else %>
  <div class="grid gap-6 lg:grid-cols-2">
    <% @leagues.each do |league| %>
      <section class="min-w-0 rounded-lg bg-white px-2 py-4 shadow-sm ring-1 ring-slate-200 sm:p-4">
        <h2 class="mb-3 text-lg font-semibold">
          <%= link_to league.name, league, class: "hover:underline" %>
        </h2>
        <%= render "leagues/standings", league: league %>
      </section>
    <% end %>
  </div>
<% end %>

<% if admin? && @season %>
  <div class="mt-8 flex flex-wrap gap-3">
    <% if @season.draft? %>
      <%= button_link_to "Poule toevoegen", new_league_path %>
      <%= button_to "Seizoen starten", start_season_path(@season), class: button_classes %>
    <% elsif @season.active? %>
      <%= button_to "Seizoen afsluiten", finish_season_path(@season), class: button_classes(:danger),
            form: { data: { turbo_confirm: season_finish_confirmation(@season) } } %>
    <% end %>
  </div>
<% end %>
