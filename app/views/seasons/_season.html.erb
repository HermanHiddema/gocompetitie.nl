<div class="border-b border-slate-100 py-2 text-sm last:border-0">
  <%= link_to season.name, season, class: "font-medium hover:underline" %>
  <% unless season.active? %>
    <span class="ml-1 text-xs text-slate-500">(<%= season_phase_name(season) %>)</span>
  <% end %>
  <% if admin? %>
    <%= link_to "bewerken", edit_season_path(season), class: "ml-2 text-slate-500 underline" %>
  <% end %>
</div>
