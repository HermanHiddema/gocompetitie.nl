<!DOCTYPE html>
<html lang="nl">
  <head>
    <title><%= content_for(:title) || "NGC #{@season&.name}" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Go Competitie">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
    <%= render "shared/navigation" %>

    <main class="mx-auto w-full max-w-6xl px-4 py-8">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>

    <footer class="mx-auto w-full max-w-6xl px-4 py-8 text-sm text-slate-500">
      Nederlandse Go Competitie<% if @season %> &ndash; <%= @season.name %><% end %>
    </footer>
  </body>
</html>
