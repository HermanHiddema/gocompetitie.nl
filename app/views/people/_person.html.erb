<div class="grid grid-cols-2 gap-x-4 gap-y-1 border-b border-slate-100 py-2 text-sm last:border-0 md:grid-cols-4">
  <div class="font-medium"><%= link_to person.name, person, class: "hover:underline" %></div>
  <div class="text-slate-600"><%= person.club&.name %></div>
  <% if current_user %>
    <div class="truncate text-slate-600"><%= person.email_addresses.join(" of ") %></div>
    <div class="text-slate-600"><%= person.phone_numbers.join(" of ") %></div>
  <% end %>
</div>
