<% content_for :title, "Inloggen" %>

<div class="mx-auto w-full max-w-md">
  <h1 class="mb-6 text-2xl font-bold">Inloggen</h1>

  <section class="rounded-lg bg-white p-5 shadow-sm ring-1 ring-slate-200">
    <%= form_with url: session_url, class: "space-y-4" do |form| %>
      <div>
        <%= form.label :email_address, User.human_attribute_name(:email_address), class: label_classes %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
              value: params[:email_address], class: field_classes %>
      </div>

      <div>
        <%= form.label :password, User.human_attribute_name(:password), class: label_classes %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: field_classes %>
      </div>

      <div class="flex items-center gap-4">
        <%= form.submit "Inloggen", class: button_classes %>
        <%= link_to "Wachtwoord vergeten?", new_password_path, class: "text-sm text-slate-600 underline" %>
      </div>
    <% end %>
  </section>
</div>
