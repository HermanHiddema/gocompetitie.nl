<% content_for :title, "Team #{@team.name}" %>
<h1 class="mb-6 text-2xl font-bold">Team <%= @team.name %></h1>

<section class="mb-8 rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
  <dl class="grid gap-2 sm:grid-cols-[8rem_1fr] text-sm">
    <dt class="font-semibold">Captain</dt>
    <dd>
      <%= @team.captain_name %>
      <% if current_user && @team.captain %>
        <%= link_to "bewerken", edit_person_path(@team.captain), class: "text-slate-500 underline" %>
        <% if @team.captain.email_addresses.any? %>
          <br><span class="text-slate-600">E-mail: <%= @team.captain.email_addresses.join(" of ") %></span>
        <% end %>
        <% if @team.captain.phone_numbers.any? %>
          <br><span class="text-slate-600">Telefoon: <%= @team.captain.phone_numbers.join(" of ") %></span>
        <% end %>
      <% end %>
    </dd>

    <dt class="font-semibold">Club</dt>
    <dd><%= link_to @team.club.name, @team.club, class: "hover:underline" %></dd>

    <dt class="font-semibold">Poule</dt>
    <dd><%= link_to @team.league.name, @team.league, class: "hover:underline" %></dd>
  </dl>
</section>

<section class="mb-8 rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
  <h2 class="mb-3 text-lg font-semibold">Teamleden</h2>
  <ol class="space-y-1 text-sm">
    <% @members.each do |member| %>
      <li>
        <span class="text-slate-400"><%= member.board_number %>.</span>
        <%= link_to member.name, member.participant, class: "hover:underline" %>
      </li>
    <% end %>
  </ol>
</section>

<section class="mb-8 rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
  <h2 class="mb-3 text-lg font-semibold">Wedstrijden</h2>
  <%= render partial: "matches/match_details", collection: @matches, as: :match %>
</section>

<% if current_user %>
  <div class="flex gap-3">
    <%= button_link_to "Team bewerken", edit_team_path(@team) %>
  </div>
<% end %>
