<div class="flex flex-col gap-1 border-b border-slate-100 py-2 text-sm last:border-0 md:flex-row md:items-baseline md:gap-4">
  <div class="md:w-1/4">
    <%= link_to team.name, team, class: "font-semibold hover:underline" %>
    <span class="text-slate-500">(<%= team.league.name %>)</span>
  </div>
  <div class="grid flex-1 gap-1 text-slate-600 md:grid-cols-3">
    <% team.team_members.sort_by { |member| -member.participant.rating.to_i }.each do |member| %>
      <span><%= member.participant.name %></span>
    <% end %>
  </div>
</div>
