<%= form_with model: group, url: group.persisted? ? group_path(group) : groups_path(**season_url_options), class: "space-y-4" do |form| %>
  <%= render "shared/errors", record: group %>

  <div>
    <%= form.label :name, class: label_classes %>
    <%= form.text_field :name, class: field_classes %>
  </div>

  <fieldset>
    <legend class="<%= label_classes %>"><%= Group.human_attribute_name(:clubs) %></legend>
    <p class="mb-2 text-xs text-slate-500">Laat leeg voor teams die bij geen enkele club horen.</p>
    <div class="grid max-h-72 gap-1 overflow-y-auto rounded-md border border-slate-300 p-3 sm:grid-cols-2">
      <%= form.collection_check_boxes :club_ids, Club.ordered, :id, :name do |box| %>
        <div class="flex items-center gap-2">
          <%= box.check_box class: "h-4 w-4 rounded border-slate-300 text-indigo-600" %>
          <%= box.label class: "text-sm text-slate-700" %>
        </div>
      <% end %>
    </div>
  </fieldset>

  <div class="flex gap-3">
    <%= form.submit "Opslaan", class: button_classes %>
    <%= button_link_to "Annuleren", groups_path(**season_url_options), style: :secondary %>
  </div>
<% end %>
