<% content_for :title, "Club bewerken" %>
<h1 class="mb-6 text-2xl font-bold">Club bewerken</h1>
<section class="rounded-lg bg-white p-5 shadow-sm ring-1 ring-slate-200">
  <%= render "form", group: @group %>
</section>

<% if @season.draft? %>
  <div class="mt-6">
    <%= button_to "Club afmelden", group_path(@group), method: :delete, class: button_classes(:danger),
          form: { data: { turbo_confirm: "Weet je het zeker?" } } %>
  </div>
<% end %>
