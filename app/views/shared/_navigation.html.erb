<header class="bg-slate-800 text-white shadow" data-controller="navigation">
  <nav class="mx-auto flex w-full max-w-6xl flex-wrap items-center gap-2 px-4 py-3">
    <%= link_to ["NGC", @season&.name].compact.join(" "), @season ? season_path(@season) : root_path,
          class: "text-lg font-bold tracking-wide" %>

    <button type="button" class="ml-auto rounded-md p-2 text-slate-200 hover:bg-slate-700 sm:hidden"
            data-action="navigation#toggle" aria-label="Menu" aria-controls="mobile-menu" aria-expanded="false">
      <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <div class="hidden w-full flex-col gap-1 sm:ml-6 sm:flex sm:w-auto sm:flex-1 sm:flex-row sm:items-center"
         data-navigation-target="menu" id="mobile-menu">
      <%= nav_link_to "Stand", @season ? season_path(@season) : root_path %>
      <%= nav_link_to "Rooster", matches_path(season_slug: @season&.slug) %>
      <%= nav_link_to "Teams", teams_path(season_slug: @season&.slug) %>
      <%= nav_link_to "Clubs", clubs_path(**season_url_options) %>
      <%= nav_link_to "Locaties", venues_path(**season_url_options) %>
      <%= nav_link_to "Archief", seasons_path(**season_url_options) %>

      <div class="sm:ml-auto">
        <% if current_user %>
          <details class="relative">
            <summary class="flex cursor-pointer list-none items-center gap-2 rounded-md px-3 py-2 text-sm text-slate-200 hover:bg-slate-700">
              <%= current_user.email_address %>
              <span aria-hidden="true">&#9662;</span>
            </summary>
            <div class="absolute right-0 z-10 mt-1 min-w-full rounded-md bg-white p-1 shadow-lg ring-1 ring-slate-200">
              <%= button_to "Uitloggen", session_path, method: :delete,
                    class: "w-full rounded px-3 py-2 text-left text-sm text-slate-700 hover:bg-slate-100 cursor-pointer" %>
            </div>
          </details>
        <% else %>
          <%= nav_link_to "Inloggen", new_session_path %>
        <% end %>
      </div>
    </div>
  </nav>
</header>
