<% flash.each do |type, message| %>
  <% next if message.blank? %>
  <div class="mb-6 rounded-md border px-4 py-3 text-sm <%= type.to_s == "alert" ? "border-red-300 bg-red-50 text-red-800" : "border-emerald-300 bg-emerald-50 text-emerald-800" %>"
       role="alert">
    <%= message %>
  </div>
<% end %>
