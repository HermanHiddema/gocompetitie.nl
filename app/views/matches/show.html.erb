<% content_for :title, "#{@match.home_team.name} - #{@match.away_team.name}" %>

<% title = capture do %>
  <%= @match.home_team.name %> &ndash; <%= @match.away_team.name %>
<% end %>

<%= page_header title do %>
  <% if current_user && @match.season&.editable? %>
    <%= button_link_to "Bewerken", edit_match_path(@match) %>
    <% if admin? %>
      <%= button_to "Verwijderen", match_path(@match), method: :delete, class: button_classes(:danger),
            form: { data: { turbo_confirm: "Weet je het zeker?" } } %>
    <% end %>
  <% end %>
<% end %>

<section class="rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
  <%= render "matches/match_details", match: @match %>
</section>
