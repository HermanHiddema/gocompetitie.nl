<% show_date = local_assigns.fetch(:show_date, false) %>
<% show_venue = local_assigns.fetch(:show_venue, false) %>

<div class="flex flex-wrap items-center gap-x-3 gap-y-1 border-b border-slate-100 py-2 text-sm last:border-0">
  <div class="min-w-0 flex-1">
    <span class="hidden sm:inline"><%= match.black_team.name %> &ndash; <%= match.white_team.name %></span>
    <span class="sm:hidden"><%= match.black_team.abbrev %> &ndash; <%= match.white_team.abbrev %></span>
  </div>

  <%= link_to match.result, match, class: "w-12 text-center font-semibold hover:underline" %>

  <div class="text-right text-slate-500">
    <% if show_date && match.playing_date %>
      <%= l match.playing_date, format: :short_with_day %>
    <% end %>
    <%= match.playing_time %>
    <% if show_venue && match.venue %>
      <%= link_to match.venue.city, match.venue, class: "hover:underline" %>
    <% end %>
  </div>
</div>
