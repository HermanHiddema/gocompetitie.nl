<% content_for :title, "Wedstrijd bewerken" %>
<h1 class="mb-2 text-2xl font-bold">Wedstrijd bewerken</h1>
<p class="mb-6 text-slate-600"><%= @match.home_team.name %> &ndash; <%= @match.away_team.name %></p>

<section class="rounded-lg bg-white p-5 shadow-sm ring-1 ring-slate-200">
  <%= form_with model: @match, class: "space-y-4" do |form| %>
    <%= render "shared/errors", record: @match %>
    <% home_player_options = @home_players.map { |player| [player.name, player.id, { data: { rating: player.rating } }] } %>
    <% away_player_options = @away_players.map { |player| [player.name, player.id, { data: { rating: player.rating } }] } %>

    <div>
      <%= form.label :venue_id, Match.human_attribute_name(:venue), class: label_classes %>
      <%= form.collection_select :venue_id, Venue.ordered, :id, :name, { include_blank: true }, class: field_classes %>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= form.label :playing_date, class: label_classes %>
        <%= form.date_field :playing_date, class: field_classes %>
      </div>
      <div>
        <%= form.label :playing_time, class: label_classes %>
        <%= form.text_field :playing_time, class: field_classes %>
      </div>
    </div>

    <h2 class="pt-4 text-lg font-semibold">Partijen</h2>
    <div class="hidden gap-3 text-sm font-medium text-slate-500 sm:grid sm:grid-cols-[1fr_1fr_8rem_8rem]">
      <span>Thuis: <%= @match.home_team.name %></span>
      <span>Uit: <%= @match.away_team.name %></span>
      <span>Handicap</span>
      <span>Resultaat</span>
    </div>

    <div class="divide-y divide-slate-200 sm:space-y-4 sm:divide-y-0">
      <%= form.fields_for :games, @games do |game_form| %>
        <% default_handicap = game_form.object.default_handicap %>
        <% selected_handicap = game_form.object.entered_handicap %>
        <% handicap_options = Game::HANDICAPS.map do |handicap|
             [handicap, handicap, { disabled: handicap > default_handicap && handicap != selected_handicap }]
           end %>
        <div class="grid gap-3 py-4 first:pt-0 last:pb-0 sm:grid-cols-[1fr_1fr_8rem_8rem] sm:py-0" data-controller="handicap">
          <%= game_form.label :home_id, "Bord #{game_form.object.board_number} thuis", class: "sr-only" %>
          <%= game_form.select :home_id, options_for_select(home_player_options, game_form.object.home_id), { include_blank: true },
                class: field_classes, data: { action: "change->handicap#update", handicap_target: "home" } %>
          <%= game_form.label :away_id, "Bord #{game_form.object.board_number} uit", class: "sr-only" %>
          <%= game_form.select :away_id, options_for_select(away_player_options, game_form.object.away_id), { include_blank: true },
                class: field_classes, data: { action: "change->handicap#update", handicap_target: "away" } %>
          <div class="grid max-w-sm grid-cols-[auto_minmax(0,1fr)_minmax(0,1fr)] items-center gap-2 sm:contents">
            <div class="contents sm:block">
              <%= game_form.label :handicap, "Handicap", class: "text-sm font-medium text-slate-500 sm:sr-only" %>
              <%= game_form.select :handicap, options_for_select(handicap_options, game_form.object.entered_handicap),
                    { include_blank: "auto (#{default_handicap})" },
                    class: field_classes, data: { handicap_target: "handicap" } %>
            </div>
            <div class="min-w-0">
              <%= game_form.label :result, "Resultaat", class: "sr-only" %>
              <%= game_form.select :result, Game::RESULTS, { selected: game_form.object.result }, class: field_classes %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <p class="text-sm text-slate-500">
      <%= link_to params[:all] ? "Alleen clubspelers tonen" : "Alle deelnemers tonen",
            edit_match_path(@match, all: params[:all] ? nil : 1), class: "underline" %>
    </p>

    <div class="flex gap-3">
      <%= form.submit "Opslaan", class: button_classes %>
      <%= button_link_to "Annuleren", match_path(@match), style: :secondary %>
    </div>
  <% end %>
</section>
