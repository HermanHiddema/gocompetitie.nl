<% content_for :title, "Wedstrijden" %>
<%= page_header "Wedstrijden" do %>
  <% if admin? && @season&.editable? %>
    <%= button_link_to "Wedstrijd toevoegen", new_match_path(**season_url_options), short: "+ Wedstrijd" %>
  <% end %>
<% end %>

<section class="rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
  <% if @matches.any? %>
    <%= render "matches/grid", matches: @matches %>
  <% else %>
    <p class="text-slate-600">Er zijn nog geen wedstrijden ingepland.</p>
  <% end %>
</section>
