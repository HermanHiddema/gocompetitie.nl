<div class="flex w-full items-center justify-between gap-3">
  <span class="min-w-0 flex-1 truncate">
    <%= game.home_player&.fullname || "?" %> &ndash; <%= game.away_player&.fullname || "?" %>
  </span>
  <% if game.handicap.positive? %>
    <span class="text-slate-500">H<%= game.handicap %></span>
  <% end %>
  <span class="w-16 text-right font-medium"><%= game.result %></span>
</div>
