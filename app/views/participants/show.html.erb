<% content_for :title, @participant.fullname %>
<h1 class="mb-6 text-2xl font-bold"><%= @participant.name %></h1>

<section class="mb-8 rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
  <dl class="grid gap-2 text-sm sm:grid-cols-[10rem_1fr]">
    <dt class="font-semibold">Seizoen</dt>
    <dd><%= @participant.season.name %></dd>

    <dt class="font-semibold">Club</dt>
    <dd>
      <% if @participant.club %>
        <%= link_to @participant.club.name, @participant.club, class: "hover:underline" %>
      <% end %>
    </dd>

    <% if @participant.team_member %>
      <dt class="font-semibold">Team</dt>
      <dd><%= link_to @participant.team_member.team.name, @participant.team_member.team, class: "hover:underline" %></dd>
    <% end %>

    <dt class="font-semibold">Graad</dt>
    <dd><%= @participant.rank %></dd>

    <dt class="font-semibold">Individuele prestatie</dt>
    <dd><%= @participant.rating_performance %></dd>
  </dl>
</section>

<section class="mb-8 rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
  <h2 class="mb-3 text-lg font-semibold">Partijen</h2>
  <ul class="space-y-1">
    <% @games.each do |game| %>
      <li class="border-b border-slate-100 py-1 text-sm last:border-0"><%= render game %></li>
    <% end %>
  </ul>
</section>

<% if current_user %>
  <div class="flex gap-3">
    <%= button_link_to "Deelnemer bewerken", edit_participant_path(@participant) %>
  </div>
<% end %>
