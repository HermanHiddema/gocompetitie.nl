<div class="grid grid-cols-3 gap-x-4 gap-y-1 border-b border-slate-100 py-2 text-sm last:border-0 md:grid-cols-4">
  <div class="col-span-2 md:col-span-1">
    <%= link_to participant.fullname, participant,
          class: "hover:underline #{"font-semibold" if participant.played_games.any?}" %>
  </div>
  <div class="text-slate-600"><%= participant.rating %></div>
  <% if current_user %>
    <div class="text-slate-600"><%= participant.rating_performance %></div>
  <% end %>
  <div class="col-span-2 hidden text-slate-600 md:block">
    <% if participant.team_member %>
      <%= link_to participant.team_member.team.name, participant.team_member.team, class: "font-medium hover:underline" %>
    <% elsif participant.club %>
      <%= link_to participant.club.name, participant.club, class: "hover:underline" %>
    <% end %>
  </div>
</div>
