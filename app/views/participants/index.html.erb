<% content_for :title, "Spelers" %>
<h1 class="mb-6 text-2xl font-bold">Alle spelers</h1>

<section class="rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
  <%= render partial: "participants/participant", collection: @participants %>
</section>

<% if admin? %>
  <div class="mt-6">
    <%= button_link_to "Speler toevoegen", new_participant_path(**season_url_options) %>
  </div>
<% end %>
