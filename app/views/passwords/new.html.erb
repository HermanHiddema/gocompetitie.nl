<% content_for :title, "Wachtwoord vergeten" %>

<div class="mx-auto w-full max-w-md">
  <h1 class="mb-6 text-2xl font-bold">Wachtwoord vergeten</h1>

  <section class="rounded-lg bg-white p-5 shadow-sm ring-1 ring-slate-200">
    <%= form_with url: passwords_path, class: "space-y-4" do |form| %>
      <div>
        <%= form.label :email_address, User.human_attribute_name(:email_address), class: label_classes %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
              value: params[:email_address], class: field_classes %>
      </div>

      <%= form.submit "Stuur instructies", class: button_classes %>
    <% end %>
  </section>
</div>
