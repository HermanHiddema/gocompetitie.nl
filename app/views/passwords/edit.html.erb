<% content_for :title, "Nieuw wachtwoord" %>

<div class="mx-auto w-full max-w-md">
  <h1 class="mb-6 text-2xl font-bold">Nieuw wachtwoord instellen</h1>

  <section class="rounded-lg bg-white p-5 shadow-sm ring-1 ring-slate-200">
    <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-4" do |form| %>
      <div>
        <%= form.label :password, User.human_attribute_name(:password), class: label_classes %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: field_classes %>
      </div>

      <div>
        <%= form.label :password_confirmation, User.human_attribute_name(:password_confirmation), class: label_classes %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: field_classes %>
      </div>

      <%= form.submit "Opslaan", class: button_classes %>
    <% end %>
  </section>
</div>
