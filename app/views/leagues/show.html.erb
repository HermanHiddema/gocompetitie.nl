<% content_for :title, @league.name %>

<%= page_header @league.name do %>
  <% if current_user %>
    <% if admin? %>
      <%= button_link_to "Poule bewerken", edit_league_path(@league), short: "Bewerken" %>
      <% if @league.season.draft? %>
        <%= button_link_to "Team toevoegen", new_team_path(league_id: @league.id, **season_url_options), style: :secondary, short: "+ Team" %>
      <% end %>
    <% end %>
    <%= button_link_to "Resultaten (EGD)", league_path(@league, format: :text), style: :secondary, short: "EGD" %>
  <% end %>
<% end %>

<section class="mb-8 rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
  <h2 class="mb-3 text-lg font-semibold">Stand</h2>
  <%= render "leagues/standings", league: @league %>
</section>

<section class="mb-8 rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
  <h2 class="mb-3 text-lg font-semibold">Wedstrijden</h2>
  <%= render "matches/grid", matches: @matches %>
</section>

<section id="teams" class="mb-8 rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
  <h2 class="mb-3 text-lg font-semibold">Teams</h2>
  <%= render @teams %>
</section>

<% if current_user %>
  <section class="mb-8 rounded-lg bg-white p-4 shadow-sm ring-1 ring-slate-200">
    <h2 class="mb-3 text-lg font-semibold">Spelers</h2>
    <%= render partial: "participants/participant", collection: @participants %>
  </section>
<% end %>
