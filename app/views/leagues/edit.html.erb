<% content_for :title, "Poule bewerken" %>
<h1 class="mb-6 text-2xl font-bold">Poule bewerken</h1>
<section class="rounded-lg bg-white p-5 shadow-sm ring-1 ring-slate-200">
  <%= render "form", league: @league %>
</section>

<div class="mt-6">
  <%= button_to "Poule verwijderen", league_path(@league), method: :delete, class: button_classes(:danger),
        form: { data: { turbo_confirm: "Weet je het zeker?" } } %>
</div>
