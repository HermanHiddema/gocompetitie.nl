<% teams = league.ranked_teams %>

<% if teams.empty? %>
  <p class="text-sm text-slate-600">Nog geen teams ingedeeld.</p>
<% else %>
  <div class="overflow-x-auto">
    <table class="w-full table-auto border-collapse text-xs md:text-sm">
      <thead>
        <tr class="text-slate-500">
          <th class="py-1 text-left font-medium">Team</th>
          <% teams.each do |team| %>
            <th class="px-0 py-1 text-center font-medium md:px-1" title="<%= team.name %>"><%= team.abbrev %></th>
          <% end %>
          <th class="px-0 py-1 text-center font-medium md:px-1" title="Wedstrijdpunten">WP</th>
          <th class="px-0 py-1 text-center font-medium md:px-1" title="Bordpunten">BP</th>
        </tr>
      </thead>
      <tbody>
        <% teams.each do |team| %>
          <tr class="border-t border-slate-100">
            <th class="py-1 pr-0 text-left font-normal md:pr-2">
              <%= link_to team, class: "hover:underline" do %>
                <span class="hidden md:inline"><%= team.name %></span>
                <span class="md:hidden"><%= team.abbrev %></span>
              <% end %>
            </th>
            <% teams.each do |opponent| %>
              <% if team.id == opponent.id %>
                <td class="px-0 py-1 text-center text-slate-300 md:px-1">&times;</td>
              <% else %>
                <% standing = league.standing(team, opponent) %>
                <% if standing.nil? %>
                  <td class="px-0 py-1 text-center md:px-1">
                    <% if admin? %>
                      <%= link_to "+", new_match_path(league_id: league.id, black_team_id: team.id, white_team_id: opponent.id, **season_url_options),
                            class: "text-slate-400 hover:text-slate-900", title: "Wedstrijd plannen" %>
                    <% end %>
                  </td>
                <% else %>
                  <td class="px-0 py-1 text-center md:px-1 <%= { "won" => "bg-emerald-50 text-emerald-800", "lost" => "bg-red-50 text-red-800" }.fetch(standing.status, "text-slate-600") %>">
                    <%= link_to standing.match, title: standing.venue&.city, class: "block hover:underline" do %>
                      <% if standing.points %>
                        <%= format_fraction(standing.points) %>
                      <% elsif standing.match.playing_date %>
                        <span class="whitespace-nowrap text-[11px] md:text-xs"><%= l standing.match.playing_date, format: :short %></span>
                      <% else %>
                        &ndash;
                      <% end %>
                    <% end %>
                  </td>
                <% end %>
              <% end %>
            <% end %>
            <td class="px-0 py-1 text-center font-semibold md:px-1"><%= format_fraction(team.score) %></td>
            <td class="px-0 py-1 text-center font-semibold md:px-1"><%= format_fraction(team.points) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
